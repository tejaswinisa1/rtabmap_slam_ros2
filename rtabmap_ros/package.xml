<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtabmap_ros</name>
  <version>2.0.0</version>
  <description>UAV SLAM Stack — ROS2 Jazzy / Ubuntu 24.04 / Raspberry Pi 5</description>
  <maintainer email="uav@example.com">UAV Team</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core RTAB-Map packages (upstream, kept) -->
  <exec_depend>rtabmap_conversions</exec_depend>
  <exec_depend>rtabmap_msgs</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_sync</exec_depend>
  <exec_depend>rtabmap_util</exec_depend>

  <!-- UAV-specific packages -->
  <exec_depend>uav_nodes</exec_depend>
  <exec_depend>uav_slam_launch</exec_depend>

  <!-- Removed (ground-robot / upstream-only):
       rtabmap_demos, rtabmap_costmap_plugins, rtabmap_examples,
       rtabmap_launch, rtabmap_python, rtabmap_rviz_plugins, rtabmap_viz -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
