{
    "name": "UAV SLAM — ROS2 Jazzy / Ubuntu 24.04",
    "build": {
        "dockerfile": "Dockerfile",
        "pull": true
    },
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-themes",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools-extension-pack",
                "ms-python.python",
                "ms-python.pylint",
                "twxs.cmake"
            ],
            "settings": {
                "python.autoComplete.extraPaths": [
                    "/opt/ros/jazzy/lib/python3/dist-packages"
                ],
                "terminal.integrated.defaultProfile.linux": "bash",
                "cmake.configureArgs": [
                    "-DCMAKE_BUILD_TYPE=Release",
                    "-DCMAKE_CXX_STANDARD=17"
                ]
            }
        }
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/uav_ws/src/rtabmap_slam_ros2,type=bind",
    "workspaceFolder": "/home/vscode/uav_ws",
    "postCreateCommand": "bash -c 'source /opt/ros/jazzy/setup.bash && export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp && colcon build --packages-select uav_nodes uav_slam_launch --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=17 --parallel-workers 2 && echo BUILD OK'",
    "runArgs": [
        "--privileged",
        "--network=host",
        "--env=DISPLAY",
        "--env=QT_X11_NO_MITSHM=1",
        "--env=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp",
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix",
        "--device=/dev/bus/usb"
    ],
    "containerEnv": {
        "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
        "ROS_DOMAIN_ID": "0"
    }
}
